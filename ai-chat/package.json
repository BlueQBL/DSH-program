{
  "name": "ai-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "对谈录 · AI 聊天助手：多轮记忆、逐字流式输出、本地保存、一键清空（零依赖，Node 原生 + 原生前端）",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node test/run-tests.mjs && node test/store-tests.mjs",
