    "test:store": "node test/store-tests.mjs",
    "verify:sse": "node test/verify-sse.mjs",
    "verify:turns": "node test/verify-turns.mjs",
    "verify:models": "node test/verify-models.mjs",
    "check:upstream": "node test/check-upstream.mjs"
