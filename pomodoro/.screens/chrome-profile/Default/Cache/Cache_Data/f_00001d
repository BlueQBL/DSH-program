  }

  const todayStats = (state, now = new Date()) => dayStats(state, dayKey(now));

  /** 最近 n 天（含今天）的日期键，按时间正序 */
  function recentKeys(state, n, now = new Date()) {
    const keys = [];
    for (let i = n - 1; i >= 0; i--) {
      keys.push(dayKey(new Date(now.getFullYear(), now.getMonth(), now.getDate() - i)));
    }
    return keys;
  }

  /** 最近 n 天的每日番茄数，按时间正序，最后一项是今天。 */
  function series(state, n = 7, now = new Date()) {
    const out = [];
    const today = dayKey(now);
    for (const key of recentKeys(state, n, now)) {
      const [y, m, d] = key.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      const st = dayStats(state, key);
      out.push({
        key,
        date,
        label: `${date.getMonth() + 1}/${date.getDate()}`,
        weekday: '日一二三四五六'[date.getDay()],
        pomodoros: st.pomodoros,
        focusMin: st.focusMin,
        isToday: key === today,
      });
    }
    return out;
  }

  /** 最近 n 天里的全部会话记录（正序），效率相关的图都从它派生 */
  function sessionsInRange(state, n = 7, now = new Date()) {
    const out = [];
    for (const key of recentKeys(state, n, now)) out.push(...dayStats(state, key).sessions);
    return out.sort((a, b) => a.endTs - b.endTs);
  }

  /** 按「开始时间所在的小时」统计番茄数，用来找自己一天里最出活的时段。 */
  function hourHistogram(state, n = 7, now = new Date()) {
    const buckets = new Array(24).fill(0);
    for (const r of sessionsInRange(state, n, now)) {
      if (!isFocus(r)) continue;
      buckets[new Date(r.startTs).getHours()] += 1;
    }
    const peak = Math.max(0, ...buckets);
    return buckets.map((count, hour) => ({ hour, count, peak }));
  }

  /**
   * 区间内的效率指标。
   * 只统计有记录的天数（activeDays）计算日均，否则周末会被算成 0 拉低平均值。
   */
  function efficiency(state, n = 7, now = new Date()) {
    const days = series(state, n, now);
    const goal = state.settings.goal;
    const pomodoros = days.reduce((a, d) => a + d.pomodoros, 0);
    const focusMin = days.reduce((a, d) => a + d.focusMin, 0);
    const active = days.filter((d) => d.pomodoros > 0);
    const goalHitDays = days.filter((d) => d.pomodoros >= goal).length;

    let best = days[0] || null;
    for (const d of days) if (best && d.pomodoros > best.pomodoros) best = d;

    const sessions = sessionsInRange(state, n, now);
    const breakMin = sessions.filter((r) => !isFocus(r)).reduce((a, r) => a + r.plannedMin, 0);
    const span = focusMin + breakMin;

    const doneTasks = state.tasks.filter((t) => t.done).length;
    const totalTasks = state.tasks.length;

    return {
      days: n,
      pomodoros,
      focusMin,
      breakMin,
      activeDays: active.length,
      idleDays: days.length - active.length,
      goalHitDays,
      goalMissDays: active.length - goalHitDays,
      avgPerDay: days.length ? pomodoros / days.length : 0,
      avgPerActiveDay: active.length ? pomodoros / active.length : 0,
      avgFocusMinPerActiveDay: active.length ? focusMin / active.length : 0,
      focusRatio: span > 0 ? focusMin / span : 0,
      best: best && best.pomodoros > 0 ? { key: best.key, label: best.label, pomodoros: best.pomodoros } : null,
      completionRate: totalTasks ? doneTasks / totalTasks : 0,
      doneTasks,
      totalTasks,
    };
  }

  /** 区间内每个任务吃掉的番茄数，从多到少。没有归属的归到「未指派」。 */
  function taskBreakdown(state, n = 7, now = new Date()) {
    const map = new Map();
    for (const r of sessionsInRange(state, n, now)) {
      if (!isFocus(r)) continue;
      const id = r.taskId || '';
      const row = map.get(id) || { id, pomodoros: 0, focusMin: 0, lastAt: 0 };
      row.pomodoros += 1;
      row.focusMin += r.plannedMin;
      row.lastAt = Math.max(row.lastAt, r.endTs);
      map.set(id, row);
    }
    return Array.from(map.values())
      .map((row) => {
        const t = taskById(state, row.id);
        return {
          ...row,
          title: row.id ? (t ? t.title : '已删除的任务') : '未指派',
          done: t ? t.done : false,
          estimate: t ? t.estimate : 0,
          known: !!t,
        };
      })
      .sort((a, b) => b.pomodoros - a.pomodoros || a.title.localeCompare(b.title));
  }

  /** 全期汇总（不限区间），用于任务行上的累计进度 */
  function taskStats(state, id) {
    let pomodoros = 0;
    let focusMin = 0;
    let lastAt = 0;
    for (const key of Object.keys(state.days)) {
      for (const r of dayStats(state, key).sessions) {
        if (!isFocus(r) || r.taskId !== id) continue;
        pomodoros += 1;
        focusMin += r.plannedMin;
        lastAt = Math.max(lastAt, r.endTs);
      }
    }
    return { pomodoros, focusMin, lastAt };
  }

  /** 连续天数：今天有记录就从今天往回数，今天还没有就从昨天算起（当天的机会还没用完）。 */
  function streak(state, now = new Date()) {
    let count = 0;
    for (let i = 0; i < KEEP_DAYS; i++) {
      const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
      const has = dayStats(state, dayKey(d)).pomodoros > 0;
      if (has) count += 1;
      else if (i > 0) break;
    }
    return count;
  }

  function totals(state) {
    const keys = Object.keys(state.days);
    let pomodoros = 0;
    let focusMin = 0;
    for (const key of keys) {
      const st = dayStats(state, key);
      pomodoros += st.pomodoros;
      focusMin += st.focusMin;
    }
    const activeDays = keys.filter((k) => dayStats(state, k).pomodoros > 0).length;
    return { pomodoros, focusMin, activeDays };
  }

  function removeRecord(state, id) {
    for (const [key, day] of Object.entries(state.days)) {
      const i = day.sessions.findIndex((r) => r.id === id);
      if (i >= 0) {
        day.sessions.splice(i, 1);
        if (!day.sessions.length) delete state.days[key];
        return true;
      }
    }
    return false;
  }

  function clearDay(state, key, now = new Date()) {
    const k = key || dayKey(now);
    if (!state.days[k]) return false;
    delete state.days[k];
    return true;
  }

  /* ── 环境音（只决定「该不该响」，怎么合成在 app.js） ── */
  /**
   * 环境音永远跟着计时状态走，不单独做开关：
   * 计时没在跑（待机或暂停）就静音；开了「仅专注时段」之后，休息也静音。
   * 这样只需要一个纯函数就能说清规则，也不会出现「钟停了音乐还在放」。
   */
  function ambienceShouldPlay(state) {
    if (SCENE_MAP[state.settings.ambience] === undefined) return false;
    if (state.settings.ambience === 'off') return false;
    if (!state.running) return false;
    if (state.settings.ambienceFocusOnly && state.phase !== 'focus') return false;
    return true;
  }

  return {
    STORAGE_KEY,
    KEEP_DAYS,
    AUTO_LATE_MS,
    ABANDON_MS,
    PHASES,
    PHASE_MAP,
    LIMITS,
    RANGES,
    SCENES,
    SCENE_MAP,
    DEFAULTS,
    // 状态
    defaultState,
    sanitize,
    load,
    save,
    // 计时
    statusOf,
    remainingMsOf,
    progressOf,
    needleAngle,
    start,
    pause,
    toggle,
    reset,
    complete,
    nextPhaseOf,
    setRemaining,
    applySettings,
    // 任务
    addTask,
    updateTask,
    toggleTaskDone,
    removeTask,
    setActiveTask,
    taskById,
    activeTask,
    roundTask,
    taskList,
    taskStats,
    taskBreakdown,
    // 统计
    dayKey,
    dayStats,
    todayStats,
    series,
    recentKeys,
    sessionsInRange,
    hourHistogram,
    efficiency,
    streak,
    totals,
    removeRecord,
    clearDay,
    // 环境音
    ambienceShouldPlay,
    // 格式化
    formatClock,
    formatDuration,
    clamp,
  };
});
